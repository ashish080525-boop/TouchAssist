<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen overlay with dimmed background + action menu grid -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tappable dim background to close -->
    <View
        android:id="@+id/dimBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <!-- 3x3 Action Grid -->
    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/menu_bg"
        android:padding="16dp"
        android:elevation="16dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnHome"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_home" />
                <TextView style="@style/MenuLabel"
                    android:text="Home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBack"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_back" />
                <TextView style="@style/MenuLabel"
                    android:text="Back" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnRecents"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_recents" />
                <TextView style="@style/MenuLabel"
                    android:text="Recents" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnScreenshot"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_screenshot" />
                <TextView style="@style/MenuLabel"
                    android:text="Screenshot" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNotifications"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_notifications" />
                <TextView style="@style/MenuLabel"
                    android:text="Notify" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnLock"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_lock" />
                <TextView style="@style/MenuLabel"
                    android:text="Lock" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnVolumeUp"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_vol_up" />
                <TextView style="@style/MenuLabel"
                    android:text="Vol +" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnVolumeDown"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_vol_down" />
                <TextView style="@style/MenuLabel"
                    android:text="Vol −" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPower"
                style="@style/MenuButton">
                <ImageView
                    style="@style/MenuIcon"
                    android:src="@drawable/ic_power" />
                <TextView style="@style/MenuLabel"
                    android:text="Power" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
